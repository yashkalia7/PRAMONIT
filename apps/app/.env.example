# Expo public env — anything prefixed EXPO_PUBLIC_ is inlined into the bundle
# at build time, so it must never hold a secret.

# Leave unset for local development: the app then targets
# <current-host>:8000/api on web, and localhost:8000/api on native.
#
# Set this before `npm run build:web` for a real deployment:
# EXPO_PUBLIC_API_URL=https://api.your-domain.com/api
