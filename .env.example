# =============================================================
#  Pramonit Football Academy — environment TEMPLATE
#
#  This file IS committed to git. It must contain placeholders only.
#  Put real values in  apps/api/.env  — that one is gitignored.
# =============================================================
APP_NAME="Pramonit Football Academy"
ENV=dev
APP_TIMEZONE=Asia/Kolkata

# -------------------------------------------------------------
#  DATABASE — Supabase Postgres
#  Dashboard -> [Connect]  (or Settings -> Database -> Connection string)
#  Replace [YOUR-PASSWORD] with the real DB password.
#  NOTE: this is NOT the sb_secret_... API key. Different credential.
# -------------------------------------------------------------

# Pooled / transaction mode (port 6543) — used by the running API
DATABASE_URL=postgresql://postgres.PROJECTREF:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Direct (port 5432) — used by Alembic migrations ONLY.
# Migrations need session mode; the pooler cannot run DDL reliably.
DATABASE_URL_DIRECT=postgresql://postgres:[YOUR-PASSWORD]@db.PROJECTREF.supabase.co:5432/postgres

# -------------------------------------------------------------
#  AUTH
#  Generate a real one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# -------------------------------------------------------------
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# -------------------------------------------------------------
#  CLUB RULES  (the whole app's behaviour hangs off these three)
# -------------------------------------------------------------
WEEKLY_REQUIRED_SUBMISSIONS=2
AUTO_APPROVE_AFTER_HOURS=72
SWEEPER_INTERVAL_MINUTES=15
ENABLE_SWEEPER=true

# -------------------------------------------------------------
#  VIDEO STORAGE
#  local -> ./media on disk (development, zero setup)
#  s3    -> Cloudflare R2 (production)
# -------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=./media
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=200

# Cloudflare R2 — only needed when STORAGE_BACKEND=s3
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto

# -------------------------------------------------------------
#  CORS — where the Expo web build is served from
# -------------------------------------------------------------
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
